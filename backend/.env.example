# Runtime
PORT=8080
NODE_ENV=production
DEPLOY_ENV=prod

# Routing / CORS
CORS_ORIGIN=https://app.omnidial.io,https://omnidial.io,https://www.omnidial.io
COOKIE_DOMAIN=.omnidial.io
BACKEND_URL=https://api.omnidial.io
FRONTEND_URL=https://app.omnidial.io

# Postgres (Coolify env scoped per dev/stage/prod)
DATABASE_URL=postgresql://user:password@db.internal:5432/omnidial
DB_HOST=db.internal
DB_PORT=5432
DB_USER=user
DB_PASSWORD=replace-me
DB_NAME=omnidial
DB_SSL_MODE=require
DB_SSL_REJECT_UNAUTHORIZED=true

# Redis (use REDIS_URL or host/port/password)
REDIS_URL=rediss://default:replace-me@redis.internal:6379
# REDIS_HOST=redis.internal
# REDIS_PORT=6379
# REDIS_PASSWORD=replace-me
# REDIS_TLS=true

# Observability
BETTERSTACK_TOKEN=replace-me
BETTERSTACK_HOST=replace-me
AXIOM_DATASET=replace-me
AXIOM_TOKEN=replace-me
SENTRY_DSN=https://public@example.ingest.us.sentry.io/1

# Security
# BETTER_AUTH_SECRET: openssl rand -hex 32
# BETTER_AUTH_TOKEN: openssl rand -base64 32
# ENCRYPTION_KEY: openssl rand -hex 32
JWT_SECRET=replace-me-with-64-char-secret
BETTER_AUTH_SECRET=replace-me-with-64-char-secret
BETTER_AUTH_TOKEN=replace-me-with-base64-32
ENCRYPTION_KEY=replace-me-with-64-char-hex
WEBHOOK_API_KEY=replace-me

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Core providers
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
RESEND_API_KEY=replace-me
RESEND_FROM_ADDRESS=OmniDial <noreply@omnidial.io>
RESEND_FALLBACK_FROM_ADDRESS=OmniDial <noreply@omnidial.io>
MCP_API_KEY=replace-me

# Optional integrations
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# ATTIO_CLIENT_ID=
# ATTIO_CLIENT_SECRET=
# PIPEDRIVE_CLIENT_ID=
# PIPEDRIVE_CLIENT_SECRET=
# MONDAY_CLIENT_ID=
# MONDAY_CLIENT_SECRET=

# Pusher / Soketi
PUSHER_ENABLED=false
PUSHER_APP_ID=app-id
PUSHER_KEY=app-key
PUSHER_SECRET=app-secret
PUSHER_HOST=localhost
PUSHER_PORT=6001
PUSHER_USE_TLS=false

# === Telnyx (programmable voice + messaging) ===
# V2 API key from portal.telnyx.com -> Auth -> API Keys
TELNYX_API_KEY=replace-me
# TeXML account SID (shown in the TeXML application section of the portal)
TELNYX_ACCOUNT_SID=replace-me
# Ed25519 public key from portal -> Keys & Credentials -> Public Key
# (used to verify webhook signatures)
TELNYX_PUBLIC_KEY=replace-me
# Default TeXML application id (voice webhooks + WebRTC connection)
TELNYX_TEXML_APP_ID=replace-me
# Optional: messaging profile id used when purchasing SMS-capable numbers
TELNYX_MESSAGING_PROFILE_ID=
# Optional: fallback From number for conference dial-outs (manager listen)
TELNYX_DEFAULT_FROM_NUMBER=
# Optional: force webhook signature verification outside production
# VERIFY_TELNYX_SIGNATURE=1
# Credential connection holding WebRTC telephony credentials (browser clients)
TELNYX_CREDENTIAL_CONNECTION_ID=replace-me
# TeXML app SIP subdomain (e.g. myapp.sip.telnyx.com) — browser calls dial sip:callid-<id>@<this>
TELNYX_SIP_SUBDOMAIN=
# Outbound voice profile attached to the TeXML app (PSTN dial-outs)
TELNYX_OUTBOUND_VOICE_PROFILE_ID=
